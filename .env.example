# LLM (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Persistence — on Railway mount a volume at /data and set DATA_DIR=/data
DATA_DIR=data/state

# Approval tokens (HMAC). Generate: python -c "import secrets;print(secrets.token_hex(32))"
APPROVAL_SECRET=change-me

# Weekly loop schedule (cron, Asia/Kolkata) and window
PULSE_CRON=0 9 * * mon
PULSE_WINDOW_DAYS=7
REFRESH_REVIEWS_ON_RUN=true

# Optional: require this passcode (X-Reviewer-Passcode header) for approve/edit/reject/run endpoints
REVIEWER_PASSCODE=

# Eval-only fault injection (X-Eval-Fault header). Keep false in production unless running evals.
ENABLE_EVAL_HOOKS=false

# CORS — Vercel frontend URL(s), comma-separated
ALLOWED_ORIGINS=

LOG_LEVEL=INFO
